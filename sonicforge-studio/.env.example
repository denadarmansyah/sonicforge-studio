# Konfigurasi Supabase untuk Luven (luven.my.id)
# Salin berkas ini menjadi .env.local untuk pengembangan lokal,
# dan masukkan variabel yang sama di Vercel Dashboard -> Settings -> Environment Variables.
# JANGAN PERNAH memasukkan service_role key ke variabel VITE_!

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Opsional: URL kanonik produksi untuk link bagikan, OG tag, dan QR code
VITE_SITE_URL=https://luven.my.id

# Opsional: Email kontak resmi yang ditampilkan di halaman Kontak & Ketentuan Layanan
VITE_CONTACT_EMAIL=halo@luven.my.id
